{
  "name": "obsidian-clone",
  "version": "0.1.0-alpha",
  "description": "AI-powered note taking system with autonomous Gemini CLI integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ai\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:ai": "tsx watch src/ai/orchestrator.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "tsc && npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/server.js",
    "start:ai": "node dist/ai/orchestrator.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "migrate:up": "ts-node scripts/migrate.ts up",
    "migrate:down": "ts-node scripts/migrate.ts down",
    "migrate:create": "ts-node scripts/migrate.ts create",
    "seed:dev": "ts-node scripts/seed.ts",
    "db:reset": "npm run migrate:down && npm run migrate:up && npm run seed:dev",
    "prepare": "husky install"
  },
  "keywords": [
    "obsidian",
    "notes",
    "knowledge-graph",
    "ai",
    "gemini",
    "llm",
    "autonomous"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.3.0",
    "@pinecone-database/pinecone": "^1.0.0",
    "@xenova/transformers": "^2.10.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "better-sqlite3": "^9.0.0",
    "bull": "^4.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "elasticsearch": "^8.10.0",
    "express": "^4.18.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0",
    "redis": "^4.6.0",
    "socket.io": "^4.7.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.0.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seu-usuario/obsidian-clone-.git"
  }
}

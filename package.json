{
  "name": "obsidian-clone-turbo",
  "version": "0.2.0-turbo",
  "description": "AI-powered note taking system - TURBO MVP (ultra-lightweight for low-end PCs)",
  "main": "dist/server-turbo.js",
  "scripts": {
    "dev": "tsx watch src/server-turbo.ts",
    "build": "tsc",
    "start": "node dist/server-turbo.js",
    "db:init": "tsx scripts/init-db.ts",
    "db:reset": "rm -f knowledge.db && npm run db:init",
    "ingest": "tsx scripts/ingest-cli.ts",
    "test": "echo 'Tests coming soon'",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "notes",
    "knowledge-graph",
    "ai",
    "lightweight",
    "sqlite",
    "local-first"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.39",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

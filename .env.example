# ============================================================================
# OBSIDIAN CLONE - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in with your values
# ============================================================================

# ============================================================================
# 1. SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=info

# ============================================================================
# 2. GEMINI CLI - PRIMARY AI ENGINE (Login Once, Use Forever)
# ============================================================================
# Instale globalmente: npm install -g @google/generative-ai-cli
# Autentique uma vez: gemini-cli login
# A sessão persiste automaticamente para este app usar
# ============================================================================
GEMINI_CLI_ENABLED=true

# ============================================================================
# 3. LOCAL LANGUAGE MODELS (Fallback if Gemini CLI unavailable)
# ============================================================================
# Embeddings locais usando Xenova/transformers (RECOMENDADO)
LOCAL_EMBEDDINGS_ENABLED=true
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-base
LOCAL_MODEL_RATE_LIMIT=100

# Modelos LSTM via Ollama para análises mais complexas
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama
OLLAMA_TIMEOUT=30000

# ============================================================================
# 4. CLOUD AI SERVICES (Fallback Chains)
# ============================================================================
# Se Gemini CLI e Ollama não estiverem disponíveis, usar API cloud

# Google Generative AI (Cloud Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.95
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY=1000

# Anthropic Claude (Secondary Fallback)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=2048

# OpenAI (Tertiary Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ============================================================================
# 5. DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL para dados principais
DATABASE_URL=postgresql://app:app123456@localhost:5432/obsidian_clone
DATABASE_POOL_SIZE=10
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000
DB_SYNC=true
DB_LOGGING=false

# Redis para cache e filas de job
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_POOL_SIZE=5
REDIS_DB=0

# SQLite para vector storage local (embeddings)
SQLITE_VECTOR_PATH=./data/vectors.db
SQLITE_VECTOR_BACKUP=./data/vectors.backup.db

# ============================================================================
# 6. SEARCH & INDEXING
# ============================================================================
# Elasticsearch para busca full-text
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=notes
ELASTICSEARCH_REPLICAS=1
ELASTICSEARCH_ENABLED=true

# Pinecone para vector search (opcional, use SQLite localmente)
PINECONE_ENABLED=false
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west-1
PINECONE_INDEX=obsidian-notes
PINECONE_DIMENSION=1536

# ============================================================================
# 7. AUTHENTICATION & SECURITY
# ============================================================================
# JWT Para session/API tokens
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRATION=30d
BCRYPT_ROUNDS=10

# Session configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS origins (ajuste para seu frontend)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================================================
# 8. SOCKET.IO WEBSOCKET CONFIGURATION
# ============================================================================
ENABLE_SOCKET_IO=true
SOCKET_IO_CORS=http://localhost:3000,http://localhost:5173
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=60000

# ============================================================================
# 9. FILE STORAGE
# ============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
NOTES_DIRECTORY=./data/notes
NOTES_BACKUP_DIRECTORY=./data/backups
ATTACHMENTS_DIRECTORY=./data/attachments

# ============================================================================
# 10. AI ENGINE BEHAVIOR CONFIGURATION
# ============================================================================
# Engine Priority Order (tenta em sequência):
# 1. GEMINI_CLI_ENABLED    (recomendado, login one-time)
# 2. OLLAMA_ENABLED        (local LLM)
# 3. GEMINI_API_KEY        (cloud fallback)
# 4. CLAUDE_API_KEY        (secondary cloud)
# 5. OPENAI_API_KEY        (tertiary cloud)

# Análise automática de novas
AI_AUTO_LINK_ENABLED=true
AI_AUTO_TAG_ENABLED=true
AI_AUTO_ANALYZE_NOTES=true
AI_INSIGHT_GENERATION_ENABLED=true
AI_GENERATE_SUMMARY=true

# AI processing configuration
AI_UPDATE_INTERVAL=1800000
AI_CONFIDENCE_THRESHOLD=0.65
AI_SUGGESTION_THRESHOLD=0.50
AI_MAX_PARALLEL_TASKS=5
AI_PRIMARY_ENGINE=gemini-cli
AI_DEBUG=false
PROCESSING_TIMEOUT=30000
BATCH_SIZE=10

# Learning e melhoria contínua
AI_ENABLE_LEARNING_LOOP=true
AI_FEEDBACK_WINDOW_HOURS=24
AI_IMPROVEMENT_THRESHOLD=0.02

# ============================================================================
# 11. GRAPH & LINKING
# ============================================================================
# Graph visualization settings
GRAPH_MAX_NODES=1000
GRAPH_CLUSTERING_ENABLED=true
GRAPH_CLUSTERING_ALGORITHM=kmeans

# Link suggestion settings
LINK_SUGGESTION_MIN_SCORE=0.65
LINK_SUGGESTION_TOP_K=5

# ============================================================================
# 12. FRONTEND CONFIGURATION
# ============================================================================
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
VITE_ENVIRONMENT=development

# ============================================================================
# 13. MONITORING & LOGGING
# ============================================================================
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_AI_DEBUG_LOGS=false
SENTRY_DSN=

# ============================================================================
# 14. DEVELOPMENT TOOLS
# ============================================================================
ENABLE_SWAGGER_DOCS=true
ENABLE_AI_DASHBOARD=true
SEED_SAMPLE_DATA=true
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# 15. CONFIGURATION PROFILES
# ============================================================================
# MÁQUINA LEVE (Laptop, 4GB RAM):
#   GEMINI_CLI_ENABLED=true
#   LOCAL_EMBEDDINGS_ENABLED=true
#   LOCAL_EMBEDDING_MODEL=Xenova/gte-small
#   OLLAMA_ENABLED=false
#   ELASTICSEARCH_ENABLED=false
#
# MÁQUINA NORMAL (Dev Box, 8-16GB RAM):
#   GEMINI_CLI_ENABLED=true
#   LOCAL_EMBEDDINGS_ENABLED=true
#   OLLAMA_ENABLED=true
#   ELASTICSEARCH_ENABLED=true
#
# MÁQUINA PODEROSA (Server, 32GB+ RAM):
#   GEMINI_CLI_ENABLED=true
#   LOCAL_EMBEDDINGS_ENABLED=true
#   OLLAMA_ENABLED=true
#   ELASTICSEARCH_ENABLED=true
#   PINECONE_ENABLED=true
